# Copy to .env (same folder) and edit. Real environment variables override this file.

# Local model served by Ollama. Check yours with:  ollama list
# Pulled already? Use it. (qwen2.5:7b, llama3.1:8b, mistral-nemo, gemma3:4b all work; qwen3:8b is the design target.)
RELIEF_LLM_HOST=http://localhost:11434
RELIEF_LLM_MODEL=qwen2.5:7b
RELIEF_LLM_TIMEOUT_S=180

# Rule search embeddings: ollama (uses nomic-embed-text from your Ollama, no extra download),
# bge (needs: pip install -e ".[bge]"), or hashing (offline, lower quality; used by tests)
RELIEF_EMBEDDER=ollama
RELIEF_EMBED_MODEL=nomic-embed-text

# Data locations (relative to the project folder)
RELIEF_DATA_DIR=data
RELIEF_VAR_DIR=var
RELIEF_REGISTRY_PATH=data/registry/registry.json

# Web server
RELIEF_API_HOST=127.0.0.1
RELIEF_API_PORT=8000
# Sign-in tokens last this many hours. Leave the secret empty to auto-generate one in var/jwt.secret
RELIEF_TOKEN_HOURS=10
RELIEF_JWT_SECRET=
# Allowed browser origins when running the frontend dev server on :5173
RELIEF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RELIEF_MAX_UPLOAD_MB=10
